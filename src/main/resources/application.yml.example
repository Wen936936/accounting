# 服务器配置
server:
  # 服务端口
  port: 8080

spring:
  # 数据源配置
  datasource:
    # MySQL 驱动类
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 数据库连接地址，库名 accounting_db，时区为上海
    url: jdbc:mysql://localhost:3306/accounting_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    # 数据库用户名
    username: root
    # 数据库密码
    password: YOUR_DB_PASSWORD # 请填入本地数据库密码
  # Redis 配置
  data:
    redis:
      # Redis 地址
      host: localhost
      # Redis 端口
      port: 6379

# JWT 鉴权配置
jwt:
  # 签名密钥，生产环境必须替换为足够长的随机字符串（HS256 至少 32 字节）
  secret: YOUR_JWT_SECRET_KEY # 请填入足够长的随机字符串
  # AccessToken 有效期，单位毫秒，1800000 即 30 分钟
  access-expiration-ms: 1800000
  # RefreshToken 有效期，单位毫秒，604800000 即 7 天
  refresh-expiration-ms: 604800000
